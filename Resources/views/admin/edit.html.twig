{% extends 'base.html.twig' %}
{% trans_default_domain 'client_report' %}

{% block title %}{{ 'edit.heading'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title mb-0">{{ 'edit.heading'|trans }}</h3>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">{{ 'edit.submit'|trans }}</button>
                <a href="{{ path('client_report_index') }}" class="btn">{{ 'edit.cancel'|trans }}</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
