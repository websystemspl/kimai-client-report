{% extends 'base.html.twig' %}
{% trans_default_domain 'client_report' %}

{% block title %}{{ 'menu.title'|trans }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">{{ 'index.heading'|trans }}</h3>
            <a href="{{ path('client_report_create') }}" class="btn btn-primary">{{ 'index.new_link'|trans }}</a>
        </div>
        {% if reports is empty %}
            <div class="card-body text-secondary">
                {{ 'index.empty'|trans }}
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                    <tr>
                        <th>{{ 'index.col.scope'|trans }}</th>
                        <th>{{ 'index.col.period'|trans }}</th>
                        <th>{{ 'index.col.link'|trans }}</th>
                        <th class="text-center">{{ 'index.col.views'|trans }}</th>
                        <th>{{ 'index.col.status'|trans }}</th>
                        <th class="w-1"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for report in reports %}
                        {% set url = url('client_report_share', {'token': report.token}) %}
                        <tr{% if not report.accessible %} class="text-secondary"{% endif %}>
                            <td>
                                <div>{{ report.scopeName }}</div>
                                {% if report.project %}
                                    <div class="text-secondary small">{{ report.customerName }}</div>
                                {% else %}
                                    <div class="text-secondary small">{{ 'index.all_projects'|trans }}</div>
                                {% endif %}
                            </td>
                            <td class="text-nowrap">
                                {{ report.dateStart|date_short }} - {{ report.dateEnd|date_short }}
                                <div class="text-secondary small">
                                    {{ report.locale|upper }}{% if not report.showNonBillable %}, {{ 'index.billable_only'|trans }}{% endif %}
                                </div>
                            </td>
                            <td>
                                <input type="text" class="form-control form-control-sm font-monospace" readonly
                                       value="{{ url }}" onclick="this.select();document.execCommand('copy');">
                                <div class="text-secondary small">{{ 'index.click_to_copy'|trans }}</div>
                            </td>
                            <td class="text-center">
                                {{ report.views }}
                                {% if report.lastViewAt %}
                                    <div class="text-secondary small text-nowrap">{{ report.lastViewAt|date_time }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if report.revoked %}
                                    <span class="badge bg-red-lt">{{ 'index.status.revoked'|trans }}</span>
                                {% elseif report.expired %}
                                    <span class="badge bg-orange-lt">{{ 'index.status.expired'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-green-lt">{{ 'index.status.active'|trans }}</span>
                                {% endif %}
                                {% if report.expiresAt %}
                                    <div class="text-secondary small text-nowrap">{{ 'index.expires_on'|trans({'%date%': report.expiresAt|date_short}) }}</div>
                                {% endif %}
                            </td>
                            <td class="text-nowrap">
                                <a href="{{ url }}" target="_blank" class="btn btn-sm">{{ 'index.action.open'|trans }}</a>
                                {% if report.revoked %}
                                    <a href="{{ path('client_report_restore', {'id': report.id, 'csrfToken': csrf_token('client_report')}) }}"
                                       class="btn btn-sm">{{ 'index.action.restore'|trans }}</a>
                                {% else %}
                                    <a href="{{ path('client_report_revoke', {'id': report.id, 'csrfToken': csrf_token('client_report')}) }}"
                                       class="btn btn-sm">{{ 'index.action.revoke'|trans }}</a>
                                {% endif %}
                                <a href="{{ path('client_report_delete', {'id': report.id, 'csrfToken': csrf_token('client_report')}) }}"
                                   class="btn btn-sm btn-ghost-danger"
                                   onclick="return confirm('{{ 'index.confirm_delete'|trans|e('js') }}');">{{ 'index.action.delete'|trans }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
